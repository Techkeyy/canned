# Canned Range Keeper deployment environment. Never commit real values.

CANNED_NETWORK=bsc-testnet
CANNED_CHAIN_ID=97

# The BNB Agent SDK reads RPC_URL_BSC_TESTNET or RPC_URL. It does NOT read
# CANNED_RPC_URL. Setting only CANNED_RPC_URL silently falls back to the SDK
# default data-seed endpoint, which rejects the eth_getLogs range that
# ERC8183JobOps.verifyJob performs; the watcher then rejects every funded job
# while HTTP readiness still looks healthy. This is the Verified Run #1 failure.
RPC_URL_BSC_TESTNET=https://bsc-testnet-rpc.publicnode.com
BNBAGENT_FALLBACK_RPC_URLS=https://bsc-testnet.public.blastapi.io,https://bsc-testnet-dataseed.bnbchain.org

# Read-only BSC mainnet endpoint for PancakeSwap market data. No mainnet write
# is ever performed with this.
CANNED_MAINNET_READ_RPC_URL=https://bsc-rpc.publicnode.com

CANNED_RANGE_AGENT_URL=https://range-keeper.<your-host>/erc8183
CANNED_RANGE_PROVIDER_ADDRESS=0x...
CANNED_RANGE_PROVIDER_PASSWORD=<keystore password, secret manager only>
CANNED_RANGE_TASK_FILE=/etc/canned/rebalancebench-v1.json
CANNED_DATA_DIR=/var/lib/canned
CANNED_RANGE_BIND_HOST=127.0.0.1
CANNED_RANGE_PORT=8791

# Pinata-compatible JWT consumed by the SDK IPFSStorageProvider. Secret manager
# or process environment only; never Git, never a screenshot.
STORAGE_API_KEY=<jwt>

# Fulfillment additionally requires CANNED_RANGE_ALLOW_TESTNET_WRITES=true.
CANNED_RANGE_ENABLE_FULFILLMENT=false
CANNED_RANGE_ALLOW_TESTNET_WRITES=false

# Set after ERC-8004 registration so /metadata publishes the registered identity.
# CANNED_RANGE_AGENT_ID=
# CANNED_RANGE_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
