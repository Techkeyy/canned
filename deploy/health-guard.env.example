# Copy to /etc/canned/health-guard.env on the VPS and chmod 600.
# Never commit the populated file. Values below are intentionally blank.
CANNED_NETWORK=bsc-testnet
CANNED_CHAIN_ID=97
CANNED_RPC_URL=https://bsc-testnet-rpc.publicnode.com
CANNED_REFERENCE_AGENT_URL=https://REPLACE_WITH_EXISTING_DEDICATED_HOST/erc8183
CANNED_REFERENCE_HEALTH_PROVIDER_ADDRESS=
CANNED_REFERENCE_PROVIDER_PASSWORD=
CANNED_REFERENCE_TASK_FILE=/etc/canned/healthbench-v1.json
CANNED_DATA_DIR=/var/lib/canned/data
CANNED_REFERENCE_BIND_HOST=127.0.0.1
CANNED_REFERENCE_PORT=8790

# The installed BNB Agent SDK maps this variable to a Pinata-compatible JWT.
STORAGE_API_KEY=
STORAGE_API_URL=https://api.pinata.cloud/pinning/pinJSONToIPFS
STORAGE_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Keep false until public readiness, restart verification, and registration gates pass.
CANNED_REFERENCE_ENABLE_FULFILLMENT=false
CANNED_REFERENCE_ALLOW_TESTNET_WRITES=false
