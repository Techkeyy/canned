FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY src ./src
COPY scripts ./scripts

RUN mkdir -p /var/lib/canned/data && chown -R node:node /app /var/lib/canned
USER node

EXPOSE 8790
VOLUME ["/var/lib/canned/data"]
CMD ["node", "scripts/run-public-health-guard.mjs"]
