# Safe defaults for local development. Do not put private keys in this file.
CANNED_NETWORK=bsc-testnet
CANNED_CHAIN_ID=97
CANNED_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Optional integrations. Keep credentials server-side only.
CANNED_8004SCAN_API_KEY=
CANNED_DATABASE_URL=
CANNED_STORAGE_ENDPOINT=
CANNED_STORAGE_BUCKET=
CANNED_STORAGE_TOKEN=
CANNED_WALLET_ADDRESS=

# Optional buyer execution. These must point to a dedicated Canned testnet wallet.
# CANNED_EXECUTION_WALLET_PASSWORD=
# CANNED_EXECUTION_WALLET_PRIVATE_KEY=
# CANNED_EXECUTION_WALLET_ADDRESS=
# CANNED_ALLOW_TESTNET_WRITES=false

# Optional local directories.
# CANNED_DATA_DIR=./data

# First-party reference fleet. The provider address is public metadata only;
# keep its password in data/state/reference-provider-wallet-password.txt or an
# OS secret manager. The reference seller is never enabled by default.
# CANNED_REFERENCE_HEALTH_PROVIDER_ADDRESS=
# CANNED_REFERENCE_PROVIDER_PASSWORD=
# CANNED_REFERENCE_AGENT_URL=http://127.0.0.1:8787/api/reference/health-factor
# CANNED_REFERENCE_ALLOW_TESTNET_WRITES=false
# CANNED_REFERENCE_MAX_SPEND_RAW=1000000000000000

# Exact BSC testnet ERC-8183 addresses are required before building an Altana
# policy. Do not copy mainnet addresses here.
# CANNED_ERC8183_COMMERCE_ADDRESS=
# CANNED_ERC8183_ROUTER_ADDRESS=
